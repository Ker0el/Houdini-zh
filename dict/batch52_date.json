{
 "_comment": "第五十二批：文件浏览器的修改时间。形如 \" 1 Oct 2026  1:21\"（前导空格 + 双空格分隔）。组合规则只对含数字的串生效，日期正好。12 个月份各一条 —— ECMAScript 正则没有月份名到数字的映射，只能枚举。",
 "patterns": {
  "^ *([0-9]{1,2}) Jan ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年1月$1日 $3",
  "^ *([0-9]{1,2}) Feb ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年2月$1日 $3",
  "^ *([0-9]{1,2}) Mar ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年3月$1日 $3",
  "^ *([0-9]{1,2}) Apr ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年4月$1日 $3",
  "^ *([0-9]{1,2}) May ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年5月$1日 $3",
  "^ *([0-9]{1,2}) Jun ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年6月$1日 $3",
  "^ *([0-9]{1,2}) Jul ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年7月$1日 $3",
  "^ *([0-9]{1,2}) Aug ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年8月$1日 $3",
  "^ *([0-9]{1,2}) Sep ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年9月$1日 $3",
  "^ *([0-9]{1,2}) Oct ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年10月$1日 $3",
  "^ *([0-9]{1,2}) Nov ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年11月$1日 $3",
  "^ *([0-9]{1,2}) Dec ([0-9]{4}) +([0-9]{1,2}:[0-9]{2})$": "$2年12月$1日 $3"
 }
}